{
  "name": "@chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm build:prod",
    "build:dev": "tsc -p tsconfig.build.json --checkers 2",
    "build:prod": "tsc -p tsconfig.build.prod.json --checkers 2",
    "build:clean": "rm -rf dist *.tsbuildinfo",
    "dev": "pnpm start:dev",
    "node_ts": "node --env-file-if-exists=.env --enable-source-maps --import=ttsc/register",
    "start:dev": "GOMAXPROCS=2 pnpm node_ts --watch --watch-path=src src/main.ts",
    "start:debug": "GOMAXPROCS=2 pnpm node_ts --watch --watch-path=src --inspect src/main.ts",
    "start:prod": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typecheck": "tsc --noEmit --checkers 2",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "GOMAXPROCS=2 oxlint --type-aware --threads=2 -c ../../.oxlintrc.json src test vitest.config.ts drizzle.config.ts",
    "lint:fix": "pnpm lint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "GOMAXPROCS=2 pnpm node_ts src/db/migrate-cli.ts",
    "db:seed": "GOMAXPROCS=2 pnpm node_ts src/db/seed-cli.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "~5.0.5",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^12.2.1",
    "ttsc": "^0.37.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io-msgpack-parser": "^3.0.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
