{
  "name": "@chat/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:prod",
    "build:dev": "tsc -p tsconfig.build.json --checkers 2",
    "build:prod": "tsc -p tsconfig.build.prod.json --checkers 2",
    "build:clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit --checkers 2",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "GOMAXPROCS=2 oxlint --type-aware --threads=2 -c ../../.oxlintrc.json src",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~5.0.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
